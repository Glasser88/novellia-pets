# Copy to .env for local development (`make env`). Dev-only credentials;
# they match the `db` service in docker-compose.yml.
DATABASE_URL="postgresql://novellia:novellia@localhost:5432/novellia"

# The time zone "today" is judged in (due dates are calendar dates). Leave unset
# to use the machine's own zone; Docker containers default to UTC, so `make up`
# sets it explicitly in docker-compose.yml.
# TZ="America/Edmonton"
